# ============================================
# PhotoLens AI - 环境变量配置模板
# 复制此文件为 .env 并填入你的配置
#   cp .env.example .env
# ============================================

# --- LLM 配置（必填，至少配置一个） ---

# DeepSeek API（推荐）
# 从 https://platform.deepseek.com/ 获取 API Key
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=3

# OpenAI API（备选）
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4

# --- 照片搜索引擎 ---

# 默认扫描目录
PHOTO_SCAN_DIR=~/Pictures

# 支持所有 OpenAI 兼容接口（DeepSeek / OpenAI / Ollama / Kimi 等）
LLM_PROVIDER=deepseek

# --- Milvus 向量数据库（可选） ---
# 如果不使用 Milvus，系统会自动降级到 JSON 文件索引
# MILVUS_ADDRESS=localhost:19530

# --- ML 服务 ---
ML_SERVICE_URL=http://127.0.0.1:8000

# --- 标签空间配置 ---
# LABEL_SPACE_PATH=config/label_space_v1.json
